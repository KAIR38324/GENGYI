<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Gengyi.Cad.AutoCAD2024</AssemblyName>
    <RootNamespace>Gengyi.Cad.AutoCAD2024</RootNamespace>
    <Version>0.3.0</Version>
    <Description>GENGYI three-room layout plugin for AutoCAD 2024</Description>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../references/image_manifest.json" LogicalName="Gengyi.SourceEvidence" />
    <ProjectReference Include="../Gengyi.Core/Gengyi.Core.csproj" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <!-- Autodesk DLLs are compile-time references; the installed CAD supplies them. -->
    <PackageReference Include="AutoCAD.NET" Version="[24.3.0]"
                      PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="[1.0.3]"
                      PrivateAssets="all" />
  </ItemGroup>
</Project>
